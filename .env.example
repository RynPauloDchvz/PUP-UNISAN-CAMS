# PUP UNISAN CAMS - Environment Variables Template
# Copy these keys into your Render.com Environment Variables dashboard.

# 1. Django Core Configuration
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-here
DJANGO_DEBUG=False

# 2. Database Connection (Neon.tech PostgreSQL)
# Kunin sa Neon Dashboard -> Connection Details -> Connection string
DATABASE_URL=postgres://username:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Media & File Storage (Cloudinary)
# Kunin sa Cloudinary Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Face Recognition AI Microservice (Hugging Face Spaces)
# Kunin ang URL ng iyong ginawang Hugging Face Space
AI_SERVICE_URL=https://your-username-pup-unisan-cams-ai.hf.space

# 5. Email Notifications (Gmail SMTP)
EMAIL_HOST_USER=pupunicams@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
